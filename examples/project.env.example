# Example /var/www/<slug>/.env generated by deploy-laravel.sh:
# PostgreSQL in a container + --enable-basic-auth + --install-filament.
# All values are fake. The real file has no comment block.
# With --create-backup the following lines are also appended at the end:
# "# Backup Archive" and BACKUP_ARCHIVE_PATH=/tmp/<slug>_<YYYYmmdd_HHMMSS>.zip.
# For MySQL, DB_MYSQL_NAME, DB_MYSQL_USER, DB_MYSQL_PASSWORD and
# DB_MYSQL_PASSWORD_ROOT appear instead of DB_POSTGRES_*.

SITE_HOST=app.example.com
SITE_PORT_HTTP=8231
SITE_PORT_HTTPS=4175

PHP_PORT=9342

REDIS_PORT=6621
REDIS_PASSWORD=ChangeMe_Redis1

DB_PORT=5634
DB_POSTGRES_NAME=exampledbname01
DB_POSTGRES_USER=exampledbuser01
DB_POSTGRES_PASSWORD=ChangeMe_DbPwd1

DB_NATIVE=false

AUTH_USER=exampleauthuser
AUTH_PASSWORD=ChangeMe_Auth01

# Filament Admin Credentials
FILAMENT_ADMIN_NAME=a1b2c3d4
FILAMENT_ADMIN_EMAIL=admin@example.com
FILAMENT_ADMIN_PASSWORD=ChangeMe10
