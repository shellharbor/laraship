# Пример /var/www/<slug>/.env, который генерирует deploy-laravel.sh:
# PostgreSQL в контейнере + --enable-basic-auth + --install-filament.
# Все значения фейковые. В настоящем файле этого блока комментариев нет.
# С --create-backup в конец ещё дописываются строки
# "# Backup Archive" и BACKUP_ARCHIVE_PATH=/tmp/<slug>_<YYYYmmdd_HHMMSS>.zip.
# Для MySQL вместо DB_POSTGRES_* будут DB_MYSQL_NAME, DB_MYSQL_USER,
# DB_MYSQL_PASSWORD и DB_MYSQL_PASSWORD_ROOT.

SITE_HOST=app.example.com
SITE_PORT_HTTP=8231
SITE_PORT_HTTPS=4175

PHP_PORT=9342

REDIS_PORT=6621
REDIS_PASSWORD=ChangeMe_Redis1

DB_PORT=5634
DB_POSTGRES_NAME=exampledbname01
DB_POSTGRES_USER=exampledbuser01
DB_POSTGRES_PASSWORD=ChangeMe_DbPwd1

DB_NATIVE=false

AUTH_USER=exampleauthuser
AUTH_PASSWORD=ChangeMe_Auth01

# Filament Admin Credentials
FILAMENT_ADMIN_NAME=a1b2c3d4
FILAMENT_ADMIN_EMAIL=admin@example.com
FILAMENT_ADMIN_PASSWORD=ChangeMe10
