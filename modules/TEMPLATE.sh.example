# shellcheck shell=bash disable=SC2154,SC2034
# ============================================================
# Module template (not loaded: the file name does not end in .sh)
# ============================================================
# 1. Copy this file to modules/<name>.sh. The name is lowercase letters, digits and '-' and starts
#    with a letter. Replace every "hello" with the name ('-' becomes '_' in function and variable
#    names, so module "my-mod" uses mod_my_mod_* and MOD_MY_MOD_*) and every HELLO with the upper case name.
# 2. Delete the hooks you do not need. Only MOD_HELLO_DESCRIPTION is required.
# 3. Follow the checklist in modules/README.md ("Contributing a module").
#
# The file is sourced into deploy-laravel.sh and runs as root, so keep it small and boring.
# ============================================================

MOD_HELLO_DESCRIPTION="One line shown by --list-modules"
MOD_HELLO_REQUIRES=""            # modules enabled automatically before this one, space-separated

