# Versions used by deploy-laravel.sh.
# Edit this file to select versions for new deployments. DB major upgrades also require
# compatibility checks and a data migration; existing projects are not rewritten. Read from the
# script folder (built-in defaults apply if missing). Plain KEY=VALUE lines,
# never sourced. --laravel-version overrides LARAVEL_VERSION for a single deployment.

# Laravel skeleton installed by default: laravel/laravel:^X.Y
LARAVEL_VERSION=13.0

# The oldest Laravel version --laravel-version accepts. Laravel 10.x and 11.x are no longer supported and
# Composer refuses them (unfixed security advisories); raise this when the next version is retired.
LARAVEL_MIN_VERSION=12.0

# Composer constraint for filament/filament (--install-filament)
FILAMENT_VERSION=^5.0

# Docker Official Images; major/minor lines stay explicit (never latest).
# Existing server copies are migrated separately, using dumps and new data volumes.
POSTGRES_IMAGE=postgres:17
MYSQL_IMAGE=mysql:8.4
